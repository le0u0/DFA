; Dungeon Fighter Arad — native offline combat demo
config_version=5

[application]
config/name="Dungeon Fighter Arad"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Minimal offline side-view combat prototype. macOS first; Windows target."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=648
window/size/min_width=960
window/size/min_height=540
window/size/mode=2
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.10, 0.11, 0.13, 1)

[physics]
common/physics_ticks_per_second=60
